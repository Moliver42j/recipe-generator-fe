aws_region                = "eu-west-1"
project_name              = "dishfromthis"
environment               = "dev"
api_gateway_id            = "REPLACE_ME_HTTP_API_ID"
api_gateway_stage_name    = "$default"
cognito_user_pool_id      = "REPLACE_ME_USER_POOL_ID"
cognito_app_client_id     = "REPLACE_ME_USER_POOL_APP_CLIENT_ID"
account_lambda_package_path = "../../../dist/account-state.zip"

account_routes = [
  "GET /account/state",
  "PUT /account/state",
  "POST /account/migrate-guest"
]

tags = {
  Owner = "platform"
}

enable_guardrail_alarms = true

# Add one or more SNS topic ARNs to receive guardrail alarms.
guardrail_alarm_actions = []

latency_alarm_period_seconds = 300
p50_latency_threshold_ms     = 300
p95_latency_threshold_ms     = 1200
error_rate_threshold_percent = 2

dynamodb_usage_period_seconds         = 900
dynamodb_read_units_threshold         = 40000
dynamodb_write_units_threshold        = 40000
dynamodb_throttled_requests_threshold = 1
