aws_region             = "eu-west-1"
project_name           = "dishfromthis"
environment            = "dev"
cognito_domain_prefix  = "dishfromthis-dev-auth"

callback_urls = [
  "http://localhost:5173/auth/callback",
  "https://app.example.com/auth/callback"
]

logout_urls = [
  "http://localhost:5173/",
  "https://app.example.com/"
]

google_client_id                         = "REPLACE_ME_GOOGLE_OAUTH_CLIENT_ID"
google_client_secret_ssm_parameter_name  = "/dishfromthis/dev/cognito/google/client_secret"
enable_google                            = true

apple_services_id                        = "REPLACE_ME_APPLE_SERVICES_ID"
apple_team_id                            = "REPLACE_ME_APPLE_TEAM_ID"
apple_key_id                             = "REPLACE_ME_APPLE_KEY_ID"
apple_private_key_ssm_parameter_name     = "/dishfromthis/dev/cognito/apple/private_key"
enable_apple                             = true

oauth_scopes = [
  "openid",
  "email",
  "profile"
]

tags = {
  Owner = "platform"
}
